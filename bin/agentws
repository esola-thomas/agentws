#!/usr/bin/env bash
# agentws - coordinate AI coding agents across isolated git workspaces.
#
# Usage:
#   agentws init [repo]            turn a checkout into a farm (--slots N, --root DIR)
#   agentws setup [harness...]     wire Claude Code, Codex, Copilot, Cursor, Gemini
#   agentws update                 update a managed install now (--check to only look)
#   agentws use [config]           make a farm the default for every directory
#   agentws version                print the installed version
#
#   agentws status                 all slots: branch, dirty, lock, claimable
#   agentws free                   which slots are idle
#   agentws claim "reason"         lock the first claimable slot, print its path
#                                  (--slot N: that slot or a refusal) and, on
#                                  stderr, the claim notice with the slot label
#   agentws lock <slot> "reason"   lock a specific slot
#   agentws unlock <slot>          release your own lock
#   agentws locks                  show all locks and their age
#   agentws checkpoint set [slot]  record where the task stands (--phase, --pr,
#                                  --next, --note, --body-file); slot defaults
#                                  to the one holding the current directory
#   agentws checkpoint show|clear [slot]
#   agentws sync [slot...]         fetch + prune; park the reference slot at origin/<default>.
#                                  Never moves a work slot (refresh advances idle ones)
#   agentws prune [slot...]        delete merged local branches, after listing them
#   agentws refresh [slot...]      park idle slots at origin/<default>, healing phantom dirt
#   agentws recycle <slot>         return a finished slot to service and release it
#   agentws done <slot>            alias for recycle
#   agentws reap                   recycle every finished slot with a stale or no lock
#   agentws create <slot>          create a slot; --with-env provisions its environment
#   agentws destroy <slot>         remove a slot via the provider
#   agentws doctor [slot...]       health checks, core plus provider
#   agentws tend                   safe maintenance; --check reports without changes
#   agentws tend schedule <action> install, uninstall, or status of user scheduling
#   agentws submodules             update submodule pointers in a slot, push, open a PR
#                                  (--yes all candidates, --push no final prompt,
#                                   --dry-run preview, --base B)
#   agentws config                 show the resolved configuration
#   agentws hook session-start     Claude Code hooks, installed by setup: the farm,
#   agentws hook pre-tool-use      or the slot notice; the in-slot contract guard
#
# Every command supports --json. Output is one envelope line on stdout:
#   {"ok":bool,"command":str,"data":object|null,"error":null|{"code","message"}}
# Human narrative always goes to stderr under --json.
#
# Lock liveness: export AGENTWS_PID=$$ (the long-lived session pid) before
# taking a lock and it is recorded as owner_pid/owner_start. The lock then goes
# stale the moment that process dies, instead of waiting out the TTL. Without
# AGENTWS_PID the lock expires by TTL only. The plain pid= field is the agentws
# process itself and is never used for liveness - it has already exited.
# Legacy WSCTL_PID / WSCTL_OWNER are honoured as fallbacks.
#
# Options: --dry-run     print what would happen, change nothing
#          --yes         skip confirmation on destructive actions
#          --owner ID    identity to lock as (default: $AGENTWS_OWNER, else user@host:pid)
#          --session ID  same as --owner; matches the MCP tools' session string
#          --ttl H       per-lock lifetime in hours, clamped to ttl_hours
#          --task-id ID  structured task id stored on a claim
#          --branch NAME structured task branch, or recycle branch to delete
#          --agent NAME  structured agent/model description stored on a claim
#          --slot N      claim: this slot only, with the same refusals as claim
#          --takeover    lock: re-bind your own lock to this session pid and reason
#          --phase P, --pr URL, --next TEXT, --note TEXT, --body-file F
#                        checkpoint set: fields to merge into the checkpoint
#          --require-env claim only an environment-ready slot
#          --with-env    create: provision the environment after checkout creation
#          --fix-env     doctor: provision missing or stale environments
#          --clean-untracked recycle: remove reported untracked files
#          --force       act on a locked workspace anyway
#          --json        machine-readable output
#          --print-env   claim: emit shell assignments for eval (incl. AGENTWS_LABEL)
#          --ignore-pid  disable process-liveness checks, use TTL only
#          --config PATH use this .agentws.yml
#          --            end of options: a reason may then start with a dash
#
# An unknown option is refused with exit 2 (EUSAGE), never kept as an argument.
#
# Auto-update: an install made by install.sh checks for a new release at most
# once a day, in the background. AGENTWS_NO_AUTO_UPDATE=1 turns it off;
# AGENTWS_UPDATE_CHANNEL=main follows main instead of releases.

set -uo pipefail

if [ -z "${BASH_VERSION:-}" ]; then
  printf 'agentws: this requires bash, not sh/dash. Run: bash agentws ...\n' >&2
  exit 1
fi
if [ "${BASH_VERSINFO[0]}" -lt 3 ]; then
  printf 'agentws: bash 3.2 or newer required, found %s\n' "$BASH_VERSION" >&2
  exit 1
fi
if [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; then
  printf 'agentws: bash 3.2 or newer required, found %s\n' "$BASH_VERSION" >&2
  exit 1
fi

AGENTWS_SELF="${BASH_SOURCE[0]}"
while [ -L "$AGENTWS_SELF" ]; do
  AGENTWS_LINK="$(readlink "$AGENTWS_SELF")"
  case "$AGENTWS_LINK" in
    /*) AGENTWS_SELF="$AGENTWS_LINK" ;;
    *)  AGENTWS_SELF="$(dirname "$AGENTWS_SELF")/$AGENTWS_LINK" ;;
  esac
done
AGENTWS_BIN_DIR="$(cd "$(dirname "$AGENTWS_SELF")" && pwd -P)"
AGENTWS_LIB_DIR="$(cd "$AGENTWS_BIN_DIR/../lib" && pwd -P)"

DRY=0
ASSUME_YES=0
FORCE=0
JSON=0
IGNORE_PID=0
PRINT_ENV=0
REQUIRE_ENV=0
WITH_ENV=0
FIX_ENV=0
CLEAN_UNTRACKED=0
CLAIM_TASK_ID=""
CLAIM_BRANCH=""
CLAIM_AGENT=""
CLAIM_SLOT=""
TAKEOVER=0
CP_GIVEN=0
CP_PHASE=""; CP_PHASE_SET=0
CP_PR="";    CP_PR_SET=0
CP_NEXT="";  CP_NEXT_SET=0
CP_NOTE="";  CP_NOTE_SET=0
CP_BODY_FILE=""

# shellcheck source=../lib/core.sh
. "$AGENTWS_LIB_DIR/core.sh"
# shellcheck source=../lib/config.sh
. "$AGENTWS_LIB_DIR/config.sh"
# shellcheck source=../lib/lock.sh
. "$AGENTWS_LIB_DIR/lock.sh"
# shellcheck source=../lib/provider.sh
. "$AGENTWS_LIB_DIR/provider.sh"
# shellcheck source=../lib/slots.sh
. "$AGENTWS_LIB_DIR/slots.sh"
# shellcheck source=../lib/checkpoint.sh
. "$AGENTWS_LIB_DIR/checkpoint.sh"
# shellcheck source=../lib/envelope.sh
. "$AGENTWS_LIB_DIR/envelope.sh"
# shellcheck source=../lib/commands.sh
. "$AGENTWS_LIB_DIR/commands.sh"
# shellcheck source=../lib/update.sh
. "$AGENTWS_LIB_DIR/update.sh"
# shellcheck source=../lib/setup.sh
. "$AGENTWS_LIB_DIR/setup.sh"
# shellcheck source=../lib/submodules.sh
. "$AGENTWS_LIB_DIR/submodules.sh"
# shellcheck source=../lib/tend_schedule.sh
. "$AGENTWS_LIB_DIR/tend_schedule.sh"
# shellcheck source=../lib/tend.sh
. "$AGENTWS_LIB_DIR/tend.sh"

OWNER="${AGENTWS_OWNER:-${WSCTL_OWNER:-${USER}@$(hostname -s 2>/dev/null || echo host):$$}}"
TTL_OVERRIDE="${AGENTWS_TTL:-${WSCTL_TTL:-}}"

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$AGENTWS_SELF"; }

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)    DRY=1; shift ;;
    --yes|-y)     ASSUME_YES=1; shift ;;
    --force)      FORCE=1; shift ;;
    --json)       JSON=1; shift ;;
    --ignore-pid) IGNORE_PID=1; shift ;;
    --print-env)  PRINT_ENV=1; shift ;;
    --require-env) REQUIRE_ENV=1; shift ;;
    --with-env)   WITH_ENV=1; shift ;;
    --fix-env)    FIX_ENV=1; shift ;;
    --clean-untracked) CLEAN_UNTRACKED=1; shift ;;
    --owner|--session) [ $# -ge 2 ] || die "$1 needs a value"; OWNER="$2"; shift 2 ;;
    --ttl)        [ $# -ge 2 ] || die "--ttl needs a value"; TTL_OVERRIDE="$2"; shift 2 ;;
    --task-id)    [ $# -ge 2 ] || die "--task-id needs a value"; CLAIM_TASK_ID="$2"; shift 2 ;;
    --branch)     [ $# -ge 2 ] || die "--branch needs a value"; CLAIM_BRANCH="$2"; shift 2 ;;
    --agent)      [ $# -ge 2 ] || die "--agent needs a value"; CLAIM_AGENT="$2"; shift 2 ;;
    --slot)       [ $# -ge 2 ] || die "--slot needs a slot"; CLAIM_SLOT="$2"; shift 2 ;;
    --takeover)   TAKEOVER=1; shift ;;
    --phase)      [ $# -ge 2 ] || die "--phase needs a value"; CP_PHASE="$2"; CP_PHASE_SET=1; CP_GIVEN=1; shift 2 ;;
    --pr)         [ $# -ge 2 ] || die "--pr needs a value"; CP_PR="$2"; CP_PR_SET=1; CP_GIVEN=1; shift 2 ;;
    --next)       [ $# -ge 2 ] || die "--next needs a value"; CP_NEXT="$2"; CP_NEXT_SET=1; CP_GIVEN=1; shift 2 ;;
    --note)       [ $# -ge 2 ] || die "--note needs a value"; CP_NOTE="$2"; CP_NOTE_SET=1; CP_GIVEN=1; shift 2 ;;
    --body-file)  [ $# -ge 2 ] || die "--body-file needs a path"; CP_BODY_FILE="$2"; CP_GIVEN=1; shift 2 ;;
    --config)     [ $# -ge 2 ] || die "--config needs a path"; AGENTWS_CONFIG="$2"; shift 2 ;;
    --root)       [ $# -ge 2 ] || die "--root needs a path"; INIT_ROOT="$2"; shift 2 ;;
    --slots)      [ $# -ge 2 ] || die "--slots needs a number"; INIT_SLOTS="$2"; shift 2 ;;
    --version|-V) SHOW_VERSION=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; ARGS+=("$@"); break ;;
    -?*)          PASS_OPTS="${PASS_OPTS:+$PASS_OPTS }$1"; ARGS+=("$1"); shift ;;
    *)            ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
[ "${SHOW_VERSION:-0}" -eq 1 ] && set -- version

# Options a subcommand parses itself. Anything else that looks like an option
# is refused, so a mistyped flag can never become a lock reason or a slot name.
opts_check() { # opts_check <command>
  local allowed o
  set -f
  case "$1" in
    update)     allowed="--check" ;;
    setup)      allowed="--check --remove --refresh" ;;
    submodules) allowed="--push --base" ;;
    tend)       allowed="--check --install --uninstall --status --refresh --no-refresh --reap --no-reap --no-fix-env --self-update --no-self-update" ;;
    *)          allowed="" ;;
  esac
  for o in ${PASS_OPTS:-}; do
    case " $allowed " in *" $o "*) continue ;; esac
    opts_refuse "$1" "unknown option '$o' for $1 (try --help; put -- before an argument that starts with a dash)"
  done
  set +f
  [ -z "$CLAIM_SLOT" ] || [ "$1" = claim ] || opts_refuse "$1" "--slot applies only to claim"
  [ "$TAKEOVER" -eq 0 ] || [ "$1" = lock ] || opts_refuse "$1" "--takeover applies only to lock"
  [ "$CP_GIVEN" -eq 0 ] || [ "$1" = checkpoint ] || \
    opts_refuse "$1" "--phase, --pr, --next, --note and --body-file apply only to checkpoint set"
}

opts_refuse() { # opts_refuse <command> <message>: exit 2 (EUSAGE)
  [ "$JSON" -eq 1 ] && envelope_err "$1" EUSAGE "$2"
  printf 'agentws: %s\n' "$2" >&2
  exit 2
}

NO_BACKGROUND_UPDATE=0
for ARG in "$@"; do
  [ "$ARG" != --check ] || NO_BACKGROUND_UPDATE=1
done
case "${1:-}" in update|tend) NO_BACKGROUND_UPDATE=1 ;; esac
[ "$NO_BACKGROUND_UPDATE" -eq 1 ] || update_maybe_background

# These run before config_load, which exits 3 when no config exists.
case "${1:-}" in
  init|use|setup|update|version|hook)
    CMD="$1"; shift
    opts_check "$CMD"
    case "$CMD" in
      hook) cmd_hook "$@" ;;
      *)    envelope_run "$CMD" "cmd_$CMD" "$@" ;;
    esac
    exit $? ;;
esac

# Provider commands parse their own options; core ones are checked before the
# config is read, so a bad flag is reported even when the config is missing.
case "${1:-status}" in
  status|free|claim|sync|prune|refresh|recycle|done|reap|create|destroy|doctor|tend|submodules|locks|config|lock|unlock|checkpoint|help)
    opts_check "${1:-status}" ;;
esac

config_load

case "$TTL_OVERRIDE" in ''|*[!0-9]*) [ -z "$TTL_OVERRIDE" ] || die "ttl must be a non-negative integer, got '$TTL_OVERRIDE'" ;; esac

[ -d "$AGENTWS_ROOT" ] || die "workspace root $AGENTWS_ROOT does not exist"

provider_load

CMD="${1:-status}"; shift || true

case "$CMD" in
  status)   envelope_run status  cmd_status  "$@" ;;
  free)     envelope_run free    cmd_free    "$@" ;;
  claim)    envelope_run claim   cmd_claim   "$@" ;;
  sync)     envelope_run sync    cmd_sync    "$@" ;;
  prune)    envelope_run prune   cmd_prune   "$@" ;;
  refresh)  envelope_run refresh cmd_refresh "$@" ;;
  recycle)  envelope_run recycle cmd_recycle "$@" ;;
  'done')   envelope_run done    cmd_done    "$@" ;;
  reap)     envelope_run reap    cmd_reap    "$@" ;;
  create)   envelope_run create  cmd_create  "$@" ;;
  destroy)  envelope_run destroy cmd_destroy "$@" ;;
  doctor)   envelope_run doctor  cmd_doctor  "$@" ;;
  tend)     envelope_run tend    cmd_tend    "$@" ;;
  submodules) envelope_run submodules cmd_submodules "$@" ;;
  locks)    envelope_run locks   cmd_locks   "$@" ;;
  checkpoint) envelope_run checkpoint cmd_checkpoint "$@" ;;
  config)   envelope_run config  cmd_config  "$@" ;;
  lock)
    if [ "$JSON" -eq 1 ]; then envelope_run lock cmd_lock_json "$@"
    else cmd_lock "$@"; fi ;;
  unlock)
    if [ "$JSON" -eq 1 ]; then envelope_run unlock cmd_unlock_json "$@"
    else cmd_unlock "$@"; fi ;;
  ""|help)  usage ;;
  *)
    if provider_has_command "$CMD"; then
      envelope_run "$CMD" provider_run_command "$CMD" "$@"
    else
      die "unknown command '$CMD' (try --help)"
    fi ;;
esac
